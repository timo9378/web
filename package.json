{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "build": "vite build --config vite.config.start.ts",
    "build:all": "pnpm run build:photos && pnpm run build",
    "build:gallery": "pnpm tsx scripts/builder/index.ts",
    "build:photos": "tsx scripts/builder/index.ts && node ../ai-tagger/clip_tagger.js",
    "check:headers": "tsx scripts/check-security-headers.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:a11y": "tsx scripts/check-a11y-prod.ts",
    "check:mdx": "tsx scripts/check-mdx.ts",
    "dev": "BACKEND_URL=http://127.0.0.1:3009 vite dev --config vite.config.start.ts --port 13998 --host",
    "e2e": "playwright test",
    "e2e:stack": "node tests/e2e/stack.mjs",
    "e2e:ui": "playwright test --ui",
    "export:types": "cd backend && cargo run --bin export_types",
    "lint": "oxlint --type-aware --tsconfig=tsconfig.json src && oxlint scripts server packages",
    "lint:css": "biome check --config-path=.config/biome.json .",
    "format:js": "oxfmt src scripts server packages tests",
    "check:format": "oxfmt --check src scripts server packages tests",
    "format:css": "biome format --config-path=.config/biome.json --write .",
    "preview": "node .output/server/index.mjs",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "mutate": "stryker run .config/stryker.config.json"
  },
  "dependencies": {
    "@animateicons/react": "^0.4.3",
