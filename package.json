    "@fontsource-variable/tasa-orbiter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@koimsurai/api-types": "workspace:*",
    "@koimsurai/mdx-core": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
