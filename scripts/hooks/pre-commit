#!/usr/bin/env bash
# 極簡 pre-commit（C4）：擋自己手滑——只跑 CI 裡最快、最常爆的那幾項。
# 條件觸發：動到前端 ts/tsx 才跑 tsc+oxlint；動到後端 rs 才跑 clippy。
# 跳過（趕時間/WIP commit）：git commit --no-verify
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# 只看「這次要 commit」的已暫存檔（ACM=新增/改/複製，不含刪除）
staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0

fail=0

if echo "$staged" | grep -qE '\.(ts|tsx)$'; then
  echo "▶ tsc --noEmit"
  pnpm exec tsc --noEmit || fail=1
  echo "▶ oxlint src"
  # 與 CI 一致：只掃 src。--quiet 不印 warning（免得每次 commit 噴兩百行），
  # 但 --max-warnings 仍會計數 → 新增警告當場擋下，不必等推上去才被 CI 打回。
  # 210 是「不帶 --type-aware」的存量（CI 那道 type-aware 的門檻是 292，兩者不同數）。
  # 不帶 --type-aware：pre-commit 要快（~0.3s vs ~3s），型別問題由上面的 tsc 擋。
  pnpm exec oxlint src --quiet --max-warnings 210 || fail=1
fi

if echo "$staged" | grep -qE '^backend/.*\.rs$'; then
  echo "▶ cargo clippy（backend）"
  ( cd backend && cargo clippy --all-targets -- -D warnings ) || fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "✗ pre-commit 檢查沒過——修掉上面的錯再 commit。"
  echo "  （確定要先存草稿：git commit --no-verify）"
  exit 1
fi

echo "✓ pre-commit checks passed"
