{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/routes/**/*.tsx",
        "server/routes/**/*.ts",
        "scripts/**/*.{ts,mjs,cjs}",
        "backend/scripts/**/*.cjs",
        "tests/e2e/**/*.{ts,mjs}",
        ".config/builder.config.js",
        "public/sw.js",
        "src/components/ui/**",
        "src/components/animate-ui/**"
      ],
      "project": ["src/**/*.{ts,tsx}", "server/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
      "ignore": ["src/routeTree.gen.ts", "src/hooks/use-is-in-view.ts"]
    },
    "packages/api-types": { "entry": ["index.ts"] },
    "packages/mcp-server": { "entry": ["src/index.ts"] }
  },
  "ignoreDependencies": [
    "@koimsurai/api-types",
    "decimal.js-light",
    "@sentry/cli"
  ]
}
