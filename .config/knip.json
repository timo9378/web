{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/routes/**/*.tsx",
        "server/routes/**/*.ts",
        "scripts/**/*.{ts,mjs,cjs}",
        "backend/scripts/**/*.cjs",
        "tests/e2e/**/*.{ts,mjs}",
        ".config/builder.config.js",
        "public/sw.js",
        "src/components/ui/**",
        "src/components/animate-ui/**"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "server/**/*.ts",
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ]
    }
  },
  "ignoreDependencies": [
    "@koimsurai/api-types",
    "decimal.js-light",
    "@sentry/cli"
  ],
  "stryker": [
    ".config/stryker.config.json"
  ]
}
