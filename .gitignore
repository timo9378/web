# cargo-llvm-cov 的 lcov 報告（CI 產生後直接上報 Codecov，不入庫）
lcov.info

# rollup-plugin-visualizer 產物（舊 vite.config.js 遺留；勿再入庫）
stats.html

# MCP server 編譯輸出（.mcp.json 走 tsx 跑源碼，dist 不入庫）
packages/mcp-server/dist/

# playwright 產物
.playwright-mcp/

# cargo-mutants 報告（17MB＋，光 debug.log 就 9MB；設定在 .cargo/mutants.toml，那個要入庫）
mutants.out/
mutants.out.old/

# C/C++ 編譯產物（誤留）
a.out

# playwright e2e 產物
test-results/
playwright-report/
blob-report/
.playwright/

# schemathesis / hypothesis 的範例資料庫（設定已改成 :memory:，舊的殘留也一併擋）
.schemathesis/
.hypothesis/

# 工作用的計畫／筆記，不進版控
# ⚠️ 這行只擋**新檔**。docs/ 下已被追蹤的 5 個檔案不受影響（gitignore 管不到已追蹤的），
#    它們也不會再被推上去，除非有人改動它們。真要讓它們從 repo 消失得跑
#    `git rm --cached -r docs/`，那會讓它們從 GitHub 上不見——所以沒有自動做。
docs/

# Lighthouse CI 的報告輸出（每次 lhci autorun 重產）
.lighthouseci/

# JUnit XML（CI 產給 Codecov Test Analytics，本機跑測試也可能留下）
junit-*.xml

# monaco 的 min/vs（build 時由 vite plugin 從 node_modules 複製，約 15MB，不入庫）
public/monaco/
.env.sourcemaps
